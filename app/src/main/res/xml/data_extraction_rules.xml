<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Explicit exclusions for Room SQLite database and Jetpack DataStore -->
        <exclude domain="database" path="somnus_sleep.db" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/somnus_user_preferences.preferences_pb" />
        <exclude domain="file" path="datastore" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="somnus_sleep.db" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/somnus_user_preferences.preferences_pb" />
        <exclude domain="file" path="datastore" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>